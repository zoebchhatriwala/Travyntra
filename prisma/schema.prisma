generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                    String              @id @default(uuid())
  name                  String
  slug                  String              @unique
  domain                String?             @unique
  type                  CompanyType         @default(ENTERPRISE)
  status                CompanyStatus       @default(PENDING)
  plan                  SubscriptionPlan    @default(FREE)
  subscriptionExpiresAt DateTime?
  logoUrl               String?
  currency              String              @default("USD")
  timezone              String              @default("UTC")
  country               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  activities            ActivityLog[]
  bids                  AgentBid[]
  workflow              ApprovalWorkflow?
  issuedInvoices        Invoice[]           @relation("AgencyInvoices")
  invoices              Invoice[]           @relation("CompanyInvoices")
  agencyRequests        TripRequest[]       @relation("AgencyRequests")
  requests              TripRequest[]       @relation("CompanyRequests")
  users                 User[]
  integrationsAsClient  AgencyIntegration[] @relation("CompanyIntegrations")
  integrationsAsAgency  AgencyIntegration[] @relation("AgencyIntegrations")
  policyThreshold       Json?
  taxTemplates          TaxTemplate[]       @relation("AgencyTaxTemplates")
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  name                  String?
  password              String
  role                  UserRole         @default(EMPLOYEE)
  avatarUrl             String?
  companyId             String?
  isActive              Boolean          @default(false)
  isBlocked             Boolean          @default(false)
  emailVerifiedAt       DateTime?
  otpToken              String?
  otpExpiresAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  accessLog             ActivityLog[]    @relation("ActivityActor")
  auditLog              ActivityLog[]    @relation("ActivityTarget")
  documents             Document[]
  messages              Message[]
  notifications         Notification[]
  requests              TripRequest[]
  company               Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvals             UserApproval[]
  actions               WorkflowAction[]
  collaboratingRequests TripRequest[]    @relation("RequestCollaborators")
  workflowSteps         WorkflowStep[]   @relation("UserToWorkflowStep")
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType? @default(INFO)
  link      String?
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TripRequest {
  id               String                @id @default(uuid())
  userId           String
  companyId        String
  agencyId         String?
  status           RequestStatus         @default(DRAFT)
  title            String
  destination      Json
  startDate        DateTime
  endDate          DateTime
  purpose          String?
  budget           Json?
  cost             Json?
  preferences      Json?
  parentTripId     String?
  isGroup          Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  bids             AgentBid[]
  documents        Document[]
  expenses         Expense[]
  invoice          Invoice?
  messages         Message[]
  approvalSteps    RequestApprovalStep[]
  agency           Company?              @relation("AgencyRequests", fields: [agencyId], references: [id], onDelete: SetNull)
  company          Company               @relation("CompanyRequests", fields: [companyId], references: [id], onDelete: Cascade)
  parentTrip       TripRequest?          @relation("GroupTrip", fields: [parentTripId], references: [id], onDelete: SetNull)
  childTrips       TripRequest[]         @relation("GroupTrip")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow         WorkflowAction[]
  collaborators    User[]                @relation("RequestCollaborators")
  fulfillmentItems FulfillmentItem[]

  @@index([companyId, status])
  @@index([userId, status])
}

model AgentBid {
  id        String      @id @default(uuid())
  requestId String
  /// The ID of the agency company
  agencyId  String
  amount    Json?
  taxes     Json?
  message   String?
  status    BidStatus   @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  agency    Company     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  request   TripRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, agencyId])
  @@index([agencyId, status])
}

model FulfillmentItem {
  id          String      @id @default(uuid())
  requestId   String
  title       String
  description String?
  isCompleted Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  request     TripRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documents   Document[]  @relation("FulfillmentItemDocuments")
}

/// Internal audit log for workflow transitions.
/// NOTE: This data is strictly for backend audit purposes and should NOT be exposed to the frontend UI.
model WorkflowAction {
  id        String             @id @default(uuid())
  requestId String
  actorId   String
  action    WorkflowActionType
  comment   String?
  timestamp DateTime           @default(now())
  actor     User               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  request   TripRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Message {
  id        String      @id @default(uuid())
  requestId String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime    @default(now())
  request   TripRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Document {
  id                String           @id @default(uuid())
  requestId         String?
  uploaderId        String
  fulfillmentItemId String?
  name              String
  s3Key             String
  url               String
  type              DocType          @default(OTHER)
  createdAt         DateTime         @default(now())
  request           TripRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader          User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fulfillmentItem   FulfillmentItem? @relation("FulfillmentItemDocuments", fields: [fulfillmentItemId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String          @id @default(uuid())
  requestId   String
  amount      Decimal
  currency    String          @default("USD")
  category    ExpenseCategory
  description String?
  receiptUrl  String?
  incurredAt  DateTime
  createdAt   DateTime        @default(now())
  request     TripRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ApprovalWorkflow {
  id        String         @id @default(uuid())
  name      String
  companyId String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
}

model WorkflowStep {
  id               String                @id @default(uuid())
  workflowId       String
  name             String
  order            Int
  type             ApprovalType          @default(ANY)
  kind             WorkflowStepKind      @default(INTERNAL_APPROVAL)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  requestApprovals RequestApprovalStep[]
  workflow         ApprovalWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approvers        User[]                @relation("UserToWorkflowStep")
}

model RequestApprovalStep {
  id        String         @id @default(uuid())
  requestId String
  stepId    String
  status    ApprovalStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   TripRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      WorkflowStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approvals UserApproval[]

  @@unique([requestId, stepId])
}

model UserApproval {
  id                    String              @id @default(uuid())
  requestApprovalStepId String
  userId                String
  status                ApprovalStatus      @default(PENDING)
  comment               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  requestApprovalStep   RequestApprovalStep @relation(fields: [requestApprovalStepId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestApprovalStepId, userId])
}

model Invoice {
  id        String        @id @default(uuid())
  amount    Decimal
  subtotal  Decimal       @default(0)
  currency  String        @default("USD")
  status    InvoiceStatus @default(PENDING)
  taxes     Json?
  dueDate   DateTime?
  requestId String        @unique
  companyId String
  agencyId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agency    Company       @relation("AgencyInvoices", fields: [agencyId], references: [id], onDelete: Cascade)
  company   Company       @relation("CompanyInvoices", fields: [companyId], references: [id], onDelete: Cascade)
  request   TripRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pdfUrl    String?

  @@index([companyId, status])
  @@index([agencyId, status])
}

model ActivityLog {
  id          String   @id @default(uuid())
  companyId   String
  actorId     String?
  targetId    String?
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  target      User?    @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

enum UserRole {
  SUPER_ADMIN
  TRAVEL_AGENT
  COMPANY_ADMIN
  EMPLOYEE
  AGENCY_EMPLOYEE
}

enum RequestStatus {
  DRAFT
  PENDING_COMPANY_APPROVAL
  PENDING_QUOTATION
  PENDING_AGENT_ACTION
  IN_PROGRESS
  APPROVED
  BOOKED
  COMPLETED
  REJECTED
  CANCELLED
}

enum DocType {
  PASSPORT
  VISA
  TICKET
  INVOICE
  OTHER
}

enum CompanyType {
  ENTERPRISE
  AGENT
}

enum CompanyStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum SubscriptionPlan {
  FREE
  STARTER
  ENTERPRISE
}

enum ApprovalType {
  ALL
  ANY
}

enum ApprovalStatus {
  PENDING
  WAITING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
  OVERDUE
}

model AgencyIntegration {
  id        String            @id @default(uuid())
  companyId String
  agencyId  String
  status    IntegrationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation("CompanyIntegrations", fields: [companyId], references: [id], onDelete: Cascade)
  agency  Company @relation("AgencyIntegrations", fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([companyId, agencyId])
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum WorkflowActionType {
  REQUEST_CREATED
  SUBMITTED
  APPROVED_STEP
  REJECTED
  APPROVED
  AUTO_APPROVED
  AUTO_APPROVAL_REVOKED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ExpenseCategory {
  FLIGHT
  HOTEL
  TRAIN
  MEALS
  TRANSPORT
  OTHER
}

model TaxTemplate {
  id          String   @id @default(uuid())
  agencyId    String
  name        String
  description String?
  taxes       Json // Array of {label: string, value: number, type: "PERCENTAGE" | "FIXED"}
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Company @relation("AgencyTaxTemplates", fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

enum WorkflowStepKind {
  INTERNAL_APPROVAL
  AGENT_QUOTATION
}
