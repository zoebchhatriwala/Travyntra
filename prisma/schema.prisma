generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                    String            @id @default(uuid())
  name                  String
  slug                  String            @unique
  domain                String?           @unique
  type                  CompanyType       @default(ENTERPRISE)
  status                CompanyStatus     @default(PENDING)
  plan                  SubscriptionPlan  @default(FREE)
  subscriptionExpiresAt DateTime?
  logoUrl               String?
  currency              String            @default("USD")
  timezone              String            @default("UTC")
  country               String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  activities            ActivityLog[]
  bids                  AgentBid[]
  workflow              ApprovalWorkflow?
  issuedInvoices        Invoice[]         @relation("AgencyInvoices")
  invoices              Invoice[]         @relation("CompanyInvoices")
  assignedRequests      TripRequest[]     @relation("AgentRequests")
  requests              TripRequest[]     @relation("CompanyRequests")
  users                 User[]
  integrationsAsClient  AgencyIntegration[] @relation("CompanyIntegrations")
  integrationsAsAgency  AgencyIntegration[] @relation("AgencyIntegrations")
  policyThreshold       Json?
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  name                  String?
  password              String
  role                  UserRole         @default(EMPLOYEE)
  avatarUrl             String?
  companyId             String?
  tags                  String[]         @default([])
  isActive              Boolean          @default(false)
  isBlocked             Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  accessLog             ActivityLog[]    @relation("ActivityActor")
  auditLog              ActivityLog[]    @relation("ActivityTarget")
  documents             Document[]
  messages              Message[]
  notifications         Notification[]
  requests              TripRequest[]
  company               Company?         @relation(fields: [companyId], references: [id])
  approvals             UserApproval[]
  actions               WorkflowAction[]
  collaboratingRequests TripRequest[]    @relation("RequestCollaborators")
  workflowSteps         WorkflowStep[]   @relation("UserToWorkflowStep")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model TripRequest {
  id              String                @id @default(uuid())
  userId          String
  companyId       String
  assignedAgentId String?
  status          RequestStatus         @default(DRAFT)
  title           String
  destination     Json
  startDate       DateTime
  endDate         DateTime
  purpose         String?
  budget          Json?
  cost            Json?
  preferences     Json?
  parentTripId    String?
  isGroup         Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bids            AgentBid[]
  documents       Document[]
  expenses        Expense[]
  invoice         Invoice?
  messages        Message[]
  approvalSteps   RequestApprovalStep[]
  assignedAgent   Company?              @relation("AgentRequests", fields: [assignedAgentId], references: [id])
  company         Company               @relation("CompanyRequests", fields: [companyId], references: [id])
  parentTrip      TripRequest?          @relation("GroupTrip", fields: [parentTripId], references: [id])
  childTrips      TripRequest[]         @relation("GroupTrip")
  user            User                  @relation(fields: [userId], references: [id])
  workflow        WorkflowAction[]
  collaborators   User[]                @relation("RequestCollaborators")
  fulfillmentItems FulfillmentItem[]
}

model AgentBid {
  id        String      @id @default(uuid())
  requestId String
  agentId   String
  amount    Json?
  message   String?
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  agent     Company     @relation(fields: [agentId], references: [id])
  request   TripRequest @relation(fields: [requestId], references: [id])
}

model FulfillmentItem {
  id          String      @id @default(uuid())
  requestId   String
  title       String
  description String?
  isCompleted Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  request     TripRequest @relation(fields: [requestId], references: [id])
  documents   Document[]  @relation("FulfillmentItemDocuments")
}

model WorkflowAction {
  id        String      @id @default(uuid())
  requestId String
  actorId   String
  action    String
  comment   String?
  timestamp DateTime    @default(now())
  actor     User        @relation(fields: [actorId], references: [id])
  request   TripRequest @relation(fields: [requestId], references: [id])
}

model Message {
  id        String      @id @default(uuid())
  requestId String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime    @default(now())
  request   TripRequest @relation(fields: [requestId], references: [id])
  sender    User        @relation(fields: [senderId], references: [id])
}

model Document {
  id                String           @id @default(uuid())
  requestId         String?
  uploaderId        String
  fulfillmentItemId String?
  name              String
  s3Key             String
  url               String
  type              DocType          @default(OTHER)
  createdAt         DateTime         @default(now())
  request           TripRequest?     @relation(fields: [requestId], references: [id])
  uploader          User             @relation(fields: [uploaderId], references: [id])
  fulfillmentItem   FulfillmentItem? @relation("FulfillmentItemDocuments", fields: [fulfillmentItemId], references: [id])
}

model Expense {
  id          String      @id @default(uuid())
  requestId   String
  amount      Decimal
  currency    String      @default("USD")
  category    String
  description String?
  receiptUrl  String?
  incurredAt  DateTime
  createdAt   DateTime    @default(now())
  request     TripRequest @relation(fields: [requestId], references: [id])
}

model ApprovalWorkflow {
  id        String         @id @default(uuid())
  name      String
  companyId String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id])
  steps     WorkflowStep[]
}

model WorkflowStep {
  id               String                @id @default(uuid())
  workflowId       String
  name             String
  order            Int
  type             ApprovalType          @default(ANY)
  approverTags     String[]              @default([])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  requestApprovals RequestApprovalStep[]
  workflow         ApprovalWorkflow      @relation(fields: [workflowId], references: [id])
  approvers        User[]                @relation("UserToWorkflowStep")
}

model RequestApprovalStep {
  id        String         @id @default(uuid())
  requestId String
  stepId    String
  status    ApprovalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   TripRequest    @relation(fields: [requestId], references: [id])
  step      WorkflowStep   @relation(fields: [stepId], references: [id])
  approvals UserApproval[]

  @@unique([requestId, stepId])
}

model UserApproval {
  id                    String              @id @default(uuid())
  requestApprovalStepId String
  userId                String
  status                ApprovalStatus      @default(PENDING)
  comment               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  requestApprovalStep   RequestApprovalStep @relation(fields: [requestApprovalStepId], references: [id])
  user                  User                @relation(fields: [userId], references: [id])

  @@unique([requestApprovalStepId, userId])
}

model Invoice {
  id        String        @id @default(uuid())
  amount    Decimal
  status    InvoiceStatus @default(PENDING)
  dueDate   DateTime?
  requestId String        @unique
  companyId String
  agencyId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agency    Company       @relation("AgencyInvoices", fields: [agencyId], references: [id])
  company   Company       @relation("CompanyInvoices", fields: [companyId], references: [id])
  request   TripRequest   @relation(fields: [requestId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  companyId   String
  actorId     String?
  targetId    String?
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("ActivityActor", fields: [actorId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  target      User?    @relation("ActivityTarget", fields: [targetId], references: [id])

  @@index([companyId])
}

enum UserRole {
  SUPER_ADMIN
  TRAVEL_AGENT
  COMPANY_ADMIN
  EMPLOYEE
  AGENCY_EMPLOYEE
}

enum RequestStatus {
  DRAFT
  PENDING_COMPANY_APPROVAL
  PENDING_AGENT_ACTION
  IN_PROGRESS
  APPROVED
  BOOKED
  COMPLETED
  REJECTED
  CANCELLED
}

enum DocType {
  PASSPORT
  VISA
  TICKET
  INVOICE
  OTHER
}

enum CompanyType {
  ENTERPRISE
  AGENT
}

enum CompanyStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum SubscriptionPlan {
  FREE
  STARTER
  ENTERPRISE
}

enum ApprovalType {
  ALL
  ANY
}

enum ApprovalStatus {
  PENDING
  WAITING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
  OVERDUE
}

model AgencyIntegration {
  id        String            @id @default(uuid())
  companyId String
  agencyId  String
  status    IntegrationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation("CompanyIntegrations", fields: [companyId], references: [id])
  agency  Company @relation("AgencyIntegrations", fields: [agencyId], references: [id])

  @@unique([companyId, agencyId])
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
}
